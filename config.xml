<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://teluguiptv.app"
        version="1.0.0"
        viewmodes="maximized">

  <tizen:application id="TeluguIPTV.TeluguIPTV"
                     package="TeluguIPTV"
                     required_version="9.0" />

  <content src="index.html" />

  <name>Telugu IPTV</name>
  <description>Premium Telugu IPTV for Samsung Smart TV</description>
  <author href="https://teluguiptv.app">Telugu IPTV</author>

  <icon src="icon.png" width="117" height="117" />

  <!-- Samsung TV icons -->
  <icon src="icon_hd.png" width="512" height="423" />

  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
  <tizen:privilege name="http://tizen.org/privilege/network.get" />

  <tizen:profile name="tv-samsung" />

  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hw-key-event="enable" />

  <access origin="*" subdomains="true" />

  <tizen:metadata key="http://samsung.com/tv/metadata/multicontroller.support" value="true" />
  <tizen:metadata key="http://samsung.com/tv/metadata/PlayerSupportFramePerSecond" value="true" />

</widget>
